# Bu dosyayı .env adıyla kopyalayın ve kendi bilgilerinizle doldurun.

# Veritabanı
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=vip_transfer_db

# Grafana
GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=

# Mail (ör. Gmail SMTP ve uygulama şifresi)
MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# Firebase Push
# Service-account JSON dosyasını secrets/firebase-service-account.json
# konumuna koyduktan sonra true yapın.
FIREBASE_ENABLED=false

# İleti Merkezi SMS
SMS_ENABLED=false
ILETIMERKEZI_API_URL=https://api.iletimerkezi.com/v1/send-sms/json
ILETIMERKEZI_API_KEY=
ILETIMERKEZI_API_HASH=
ILETIMERKEZI_SENDER=

# Meta WhatsApp Cloud API
WHATSAPP_ENABLED=false
WHATSAPP_API_URL=https://graph.facebook.com
WHATSAPP_API_VERSION=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
