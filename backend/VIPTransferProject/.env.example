# ── Veritabanı ────────────────────────────────────────────────────────────────
DB_URL=jdbc:postgresql://localhost:5432/your_db_name
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password

# ── Mail (isteğe bağlı) ───────────────────────────────────────────────────────
# Mail göndermek istemiyorsanız MAIL_ENABLED=false bırakın, diğer alanları boş bırakabilirsiniz.
# Mail aktif etmek için: Google hesabı → Güvenlik → 2FA açık → Uygulama Şifresi oluştur.
MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_gmail@gmail.com
MAIL_PASSWORD=your_google_app_password

APP_BASE_URL=http://localhost:8080

# Ileti Merkezi SMS
SMS_ENABLED=false
ILETIMERKEZI_API_URL=https://api.iletimerkezi.com/v1/send-sms/json
ILETIMERKEZI_API_KEY=your_iletimerkezi_api_key
ILETIMERKEZI_API_HASH=your_iletimerkezi_api_hash
ILETIMERKEZI_SENDER=your_approved_sender

# Meta WhatsApp Cloud API
WHATSAPP_ENABLED=false
WHATSAPP_API_URL=https://graph.facebook.com
WHATSAPP_API_VERSION=vXX.X
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id

# Firebase Admin SDK service account dosyasinin mutlak yolu
GOOGLE_APPLICATION_CREDENTIALS=C:/path/to/firebase-service-account.json

# ── Google Maps ───────────────────────────────────────────────────────────────
# Rota ve mesafe hesabı için kullanılır.
# Almak için: console.cloud.google.com → API & Services → Credentials → Create API Key
# Aktif edilmesi gereken API'lar: Directions API, Maps JavaScript API
google.maps.api-key=your_google_maps_api_key
